    schema:description  "Rust-powered Python library for building, querying, and transforming RDF knowledge graphs from Polars DataFrames using OTTR templates. In-memory or persistent disk-backed triple store. Core mapping, SPARQL, and serialization are open source (Apache 2.0). SHACL validation, Datalog reasoning, and disk mode require a separate proprietary license." ;
    schema:url          <https://github.com/DataTreehouse/maplib> ;
    vl:subcategory      subcat:Python-Rust-Library-plus-Triple-Store-disk-mode ;
    vl:language          lang:Python ;
    vl:language          lang:Rust ;
    vl:license           license:Apache-2.0 ;
    vl:pricing           pricingm:Open-Source-core-plus-Commercial-advanced-features ;
    vl:github            <https://github.com/DataTreehouse/maplib> ;
    vl:logoHint          "maplib DataTreehouse logo" ;
    vl:logoUrl           <https://github.com/DataTreehouse.png?size=64> ;
    vl:hasDemo           true ;
    vl:demoUrl           <https://vimeo.com/1189459767?fl=pl&fe=cm> ;
    vl:hasBenchmark      true ;
    vl:speedNote         "Very fast - Rust core with Polars/Arrow gives near-native I/O and sub-second SPARQL on millions of triples" ;
    vl:scaleNote         "In-memory by default (bounded by RAM), but disk mode handles billions of triples for larger-than-memory datasets" ;
    vl:speedTier         speed:fast ;
    vl:scaleTier         scale:large ;
    vl:region            region:Europe ;
    vl:country           country:Norway ;
    vl:focusArea         focus:Chrontext-multi-modal ;
    vl:focusArea         focus:DataFrame-to-RDF ;
    vl:focusArea         focus:Datalog-reasoning ;
    vl:focusArea         focus:Knowledge-graph-construction ;
    vl:focusArea         focus:OTTR-templates ;
    vl:focusArea         focus:SHACL-validation ;
    vl:focusArea         focus:SPARQL ;
    vl:focusArea         focus:Triple-store ;
    vl:supportsStandard  std:Datalog ;
    vl:supportsStandard  std:RDF-1-1 ;
    vl:supportsStandard  std:SHACL ;
    vl:supportsStandard  std:SPARQL-1-1 ;
    vl:firstRelease      2023 .

