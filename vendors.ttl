@base          <http://data.veronahe.no/vendors/> .
@prefix vl:      <http://data.veronahe.no/vocab#> .
@prefix focus:   <http://data.veronahe.no/focus/> .
@prefix std:     <http://data.veronahe.no/standard/> .
@prefix region:  <http://data.veronahe.no/region/> .
@prefix country: <http://data.veronahe.no/country/> .
@prefix speed:   <http://data.veronahe.no/speed/> .
@prefix scale:   <http://data.veronahe.no/scale/> .
@prefix license: <http://data.veronahe.no/license/> .
@prefix lang:    <http://data.veronahe.no/language/> .
@prefix subcat:  <http://data.veronahe.no/subcategory/> .
@prefix pricingm: <http://data.veronahe.no/pricing/> .
@prefix schema:  <https://schema.org/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# ======================================================================
# Ontology: RDF Vendor Landscape vocabulary
# ======================================================================

vl:Vendor       a owl:Class ; rdfs:label "Vendor" .
vl:Database     a owl:Class ; rdfs:subClassOf vl:Vendor ; rdfs:label "Database" .
vl:Framework    a owl:Class ; rdfs:subClassOf vl:Vendor ; rdfs:label "Framework" .
vl:Tool         a owl:Class ; rdfs:subClassOf vl:Vendor ; rdfs:label "Tool" .

vl:License          a owl:Class ; rdfs:label "License" .
vl:ProgrammingLanguage a owl:Class ; rdfs:label "Programming Language" .
vl:PricingModel     a owl:Class ; rdfs:label "Pricing Model" .
vl:SpeedTier        a owl:Class ; rdfs:label "Speed Tier" .
vl:ScaleTier        a owl:Class ; rdfs:label "Scale Tier" .

# -- SKOS Concept Schemes -----------------------------------------------
vl:FocusAreaScheme    a skos:ConceptScheme ; rdfs:label "Focus Areas" ; skos:prefLabel "Focus Areas" .
vl:SubcategoryScheme  a skos:ConceptScheme ; rdfs:label "Subcategories" ; skos:prefLabel "Subcategories" .
vl:StandardScheme     a skos:ConceptScheme ; rdfs:label "W3C/Community Standards" ; skos:prefLabel "W3C/Community Standards" .
vl:RegionScheme       a skos:ConceptScheme ; rdfs:label "Regions" ; skos:prefLabel "Regions" .
vl:CountryScheme      a skos:ConceptScheme ; rdfs:label "Countries" ; skos:prefLabel "Countries" .

# -- Properties (all with domain and range) -----------------------------

# Object properties
vl:subcategory      a owl:ObjectProperty ; rdfs:label "Subcategory" ;
    rdfs:domain vl:Vendor ; rdfs:range skos:Concept .
vl:license          a owl:ObjectProperty ; rdfs:label "License" ;
    rdfs:domain vl:Vendor ; rdfs:range vl:License .
vl:language         a owl:ObjectProperty ; rdfs:label "Programming language" ;
    rdfs:domain vl:Vendor ; rdfs:range vl:ProgrammingLanguage .
vl:pricing          a owl:ObjectProperty ; rdfs:label "Pricing model" ;
    rdfs:domain vl:Vendor ; rdfs:range vl:PricingModel .
vl:focusArea        a owl:ObjectProperty ; rdfs:label "Focus area" ;
    rdfs:domain vl:Vendor ; rdfs:range skos:Concept .
vl:supportsStandard a owl:ObjectProperty ; rdfs:label "Supports standard" ;
    rdfs:domain vl:Vendor ; rdfs:range skos:Concept .
vl:region           a owl:ObjectProperty ; rdfs:label "Region" ;
    rdfs:domain vl:Vendor ; rdfs:range skos:Concept .
vl:country          a owl:ObjectProperty ; rdfs:label "Country" ;
    rdfs:domain vl:Vendor ; rdfs:range skos:Concept .
vl:speedTier        a owl:ObjectProperty ; rdfs:label "Speed tier" ;
    rdfs:domain vl:Vendor ; rdfs:range vl:SpeedTier .
vl:scaleTier        a owl:ObjectProperty ; rdfs:label "Scale tier" ;
    rdfs:domain vl:Vendor ; rdfs:range vl:ScaleTier .

# Datatype properties
vl:github           a owl:DatatypeProperty ; rdfs:label "GitHub URL" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:anyURI .
vl:hasDemo          a owl:DatatypeProperty ; rdfs:label "Has a demo available" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:boolean .
vl:demoUrl          a owl:DatatypeProperty ; rdfs:label "Demo URL" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:anyURI .
vl:hasBenchmark     a owl:DatatypeProperty ; rdfs:label "Included in benchmark" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:boolean .
vl:logoHint         a owl:DatatypeProperty ; rdfs:label "Logo search hint" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:string .
vl:logoUrl          a owl:DatatypeProperty ; rdfs:label "Logo URL" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:anyURI .
vl:speedNote        a owl:DatatypeProperty ; rdfs:label "Speed description" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:string .
vl:scaleNote        a owl:DatatypeProperty ; rdfs:label "Scale description" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:string .
vl:warning          a owl:DatatypeProperty ; rdfs:label "Warning note" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:string .
vl:firstRelease     a owl:DatatypeProperty ; rdfs:label "First release year" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:gYear .
vl:reviewUrl        a owl:DatatypeProperty ; rdfs:label "Video review URL" ;
    rdfs:domain vl:Vendor ; rdfs:range xsd:anyURI .
vl:flag             a owl:DatatypeProperty ; rdfs:label "Emoji flag" ;
    rdfs:domain skos:Concept ; rdfs:range xsd:string .

